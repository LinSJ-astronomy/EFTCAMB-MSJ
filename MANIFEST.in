# Start from an explicit whitelist so nested worktrees and scratch clones do
# not leak into the source distribution just because they live under the repo
# root.
prune *
exclude *

# Root metadata and packaging files.
include LICENCE.txt
include MANIFEST.in
include README.md
include CAMB_README.rst
include pyproject.toml
include requirements.txt
include setup.py

# Package sources and bundled data.
recursive-include eftcamb *.py
# EFTCAMB MOD START: ship the EFTCAMB sources
recursive-include fortran Makefile* *.dat *.f *.?90 *.c *.make *.dep
# original code:
# recursive-include fortran Makefile* *.dat *.?90
# EFTCAMB MOD END
recursive-include forutils Makefile* *.?90

include eftcamb/PArthENoPE_880.2_marcucci.dat
include eftcamb/PArthENoPE_880.2_standard.dat
include eftcamb/PRIMAT_Yp_DH_Error.dat
include eftcamb/PRIMAT_Yp_DH_ErrorMC_2021.dat
include eftcamb/PRIMAT_Yp_DH_ErrorMC_2024.dat

# PyPI long description.
include docs/README_eftcamb_pypi.rst
include fortran/eftcamb/LICENSE
include forutils/LICENSE
prune fortran/eftcamb_test
prune fortran/testfiles
recursive-exclude fortran/Release *
recursive-exclude fortran/Debug *
recursive-exclude fortran/Releaselib *
recursive-exclude fortran/Debuglib *
recursive-exclude forutils/Release *
recursive-exclude forutils/Debug *
recursive-exclude forutils/Releaselib *
recursive-exclude forutils/Debuglib *
global-exclude *.o *.mod *.d

# Built artifacts and optional/generated files are shipped separately or
# rebuilt locally.
exclude .gitattributes
exclude .gitignore
exclude .gitmodules
exclude .readthedocs.yml
exclude eftcamb/cambdll.dll
exclude eftcamb/libomp.dll
exclude eftcamb/camblib.so
exclude eftcamb/HighLExtrapTemplate_lenspotentialCls.dat
